{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "thinking": "show",
    "verbosity": "high"
  },
  "keybinds": {
    "session.tab.next": "alt+l",
    "session.tab.previous": "alt+h"
  }
}
