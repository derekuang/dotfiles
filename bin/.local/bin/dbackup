#!/usr/bin/bash

# ============================================================
# 整盘数据备份脚本
# 使用 rsync 将源路径完整同步到目标路径
# ============================================================

# --- 使用说明 ---
if [ $# -ne 2 ]; then
    echo "用法: $0 <源路径> <目标路径>"
    exit 1
fi

# --- 配置变量 ---
SRC="$1" # 源路径（要备份的目录）
DST="$2" # 目标路径（备份存放的位置）
EXCLUDE=(
    "/tmp"
    "/lost+found"
    ".Trash-1000"
)

# --- rsync 选项 ---
# -a : 归档模式，保留权限、时间戳、软链接等
# -v : 显示详细信息
# -h : 人类可读的大小格式
# --delete : 删除目标中源已不存在的文件（保持完全同步）
# --progress : 显示传输进度
RSYNC_OPTS="-avh --delete --progress"

# --- 构建排除参数 ---
EXCLUDE_ARGS=""
for item in "${EXCLUDE[@]}"; do
    EXCLUDE_ARGS+="--exclude=$item "
done

# --- 前置检查 ---
if [ ! -d "$SRC" ]; then
    echo "错误: 源路径不存在或不是一个目录: $SRC"
    exit 1
fi

if [ ! -d "$DST" ]; then
    echo "错误: 目标路径不存在或不是一个目录: $DST"
    exit 1
fi

# --- 确保以 root 运行（整盘备份通常需要 root 权限） ---
if [ "$EUID" -ne 0 ]; then
    echo "警告: 建议以 root 权限运行此脚本以获得完整备份。"
    echo "如果你要继续以当前用户运行，请按 Enter，否则按 Ctrl+C 取消。"
    read -r
fi

# --- 显示备份信息 ---
echo "=============================================="
echo "  整盘数据备份"
echo "=============================================="
echo "源路径 : $SRC"
echo "目标路径 : $DST"
echo "排除项 : ${EXCLUDE[*]}"
echo "=============================================="
echo "将在 3 秒后开始备份..."
sleep 3

# --- 执行 rsync ---
rsync $RSYNC_OPTS $EXCLUDE_ARGS "$SRC/" "$DST/"

# --- 结果 ---
if [ $? -eq 0 ]; then
    echo ""
    echo "=============================================="
    echo "  备份完成: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "=============================================="
else
    echo ""
    echo "备份过程中出现错误，请检查上方输出。"
    exit 1
fi
